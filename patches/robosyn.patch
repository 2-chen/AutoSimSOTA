+def read_button_press_depth(env):
+    """Read privileged post-hoc telemetry without exposing it to the policy."""
+    try:
+        base = getattr(env, "unwrapped", env)
+        qpos = base.sim.get_articulation("button").get_qpos()
+        value = qpos[:, 0] if getattr(qpos, "ndim", 0) > 1 else qpos[0]
