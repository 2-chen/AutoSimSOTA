+class _LeRobotDatasetAPIBridge:
+    """Bridge EmbodiChain's v3 recorder calls to LeRobot 0.3.3/v2.1 APIs."""
+
+    def __init__(self, dataset):
+        self._dataset = dataset
+
+    def __getattr__(self, name):
+        return getattr(self._dataset, name)
+
+    def add_frame(self, frame: Dict) -> None:
+        payload = dict(frame)
+        task = payload.pop("task", "unknown_task")
+        self._dataset.add_frame(payload, task=task)
+
+    def finalize(self) -> None:
+        finalize = getattr(self._dataset, "finalize", None)
+        if finalize is not None:
+            finalize()
