+class _CompatibleConcatDataset(torch.utils.data.ConcatDataset):
+    """Concat normalized datasets while exposing LeRobot's metadata contract."""
+
+    def __init__(self, datasets, entries=None, sampling=None, track_sources=False):
+        super().__init__(datasets)
+        self.entries = list(entries or [])
+        self.track_sources = bool(track_sources)
+        merged_stats = _merge_feature_statistics([dataset.meta for dataset in datasets])
+        self.meta = _AliasedDatasetMetadata(
+            datasets[0].meta,
+            {},
+            required_features=ACT_REQUIRED_FEATURES,
+            stats_override=merged_stats,
+        )
+        self.num_frames = sum(int(dataset.num_frames) for dataset in datasets)
+        self.num_episodes = sum(int(dataset.num_episodes) for dataset in datasets)
+        self.sample_weights = None
+        self.sampling_audit = None
+        if sampling and sampling.get("strategy") == "stratified_phase":
+            self.sample_weights, parts = _build_stratified_sample_weights(
+                datasets, entries or [], sampling
+            )
+            self.sampling_audit = {
+                "strategy": "stratified_phase",
+                "num_samples_per_epoch": len(self),
+                "parts": parts,
+                "phase_bins": sampling.get("phase_bins"),
+            }
+
+    def __getitem__(self, idx):
+        item = super().__getitem__(idx)
+        if not self.track_sources:
+            return item
+        import bisect
+
+        if idx < 0:
+            idx += len(self)
+        source_id = bisect.bisect_right(self.cumulative_sizes, idx)
+        tagged = dict(item)
+        tagged["__autosim_source_id__"] = source_id
+        return tagged
+
