+class _ExposureAudit:
+    """Count source examples actually yielded by the DataLoader to training."""
+
+    def __init__(self, path, entries, lengths, expected_masses=None, flush_batches=50):
+        self.path = Path(path).expanduser().resolve()
+        self.entries = list(entries)
+        self.lengths = [int(value) for value in lengths]
+        self.expected_masses = list(expected_masses or [])
+        self.flush_batches = int(flush_batches)
+        self.batches = 0
+        self.samples = 0
+        self.counts = [0 for _ in self.entries]
+        self._write("initialized")
+
+    def observe(self, source_ids):
+        values = torch.as_tensor(source_ids).detach().cpu().reshape(-1).tolist()
+        for raw in values:
+            source_id = int(raw)
+            if not 0 <= source_id < len(self.counts):
+                raise ValueError(f"invalid exposure source id: {source_id}")
+            self.counts[source_id] += 1
+        self.batches += 1
+        self.samples += len(values)
+        if self.batches % self.flush_batches == 0:
+            self._write("running")
+
+    def close_iterator(self):
+        self._write("iterator_closed")
+
+    def _write(self, status):
+        rows = []
+        for index, (entry, frames, count) in enumerate(
+            zip(self.entries, self.lengths, self.counts)
+        ):
+            rows.append(
+                {
+                    "source_id": index,
+                    "root": str(entry.get("root", "")),
+                    "profile": str(entry.get("profile", "unknown")),
+                    "source_kind": str(entry.get("source_kind", entry.get("role", "unknown"))),
+                    "available_frames": frames,
+                    "expected_sampling_mass": (
+                        float(self.expected_masses[index])
+                        if len(self.expected_masses) == len(self.entries)
+                        else None
+                    ),
+                    "yielded_samples": count,
+                    "realized_sampling_mass": count / self.samples if self.samples else None,
+                }
+            )
+        payload = {
+            "schema_version": 1,
+            "kind": "robosyn_act_training_exposure_audit",
+            "status": status,
+            "updated_at": datetime.now(timezone.utc).isoformat(),
+            "semantics": "examples yielded by DataLoader after collation and before policy.update",
+            "batches_yielded": self.batches,
+            "samples_yielded": self.samples,
+            "parts": rows,
+            "limitations": [
+                "a process failure after a batch is yielded can prevent that batch update",
+                "profile labels do not prove within-profile scene coverage",
+            ],
+        }
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        temporary = self.path.with_name(self.path.name + f".{os.getpid()}.tmp")
+        with temporary.open("w", encoding="utf-8") as stream:
+            json.dump(payload, stream, indent=2)
+            stream.write("\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, self.path)
+
+
+class _ExposureTrackingLoader:
+    def __init__(self, loader, audit):
+        self._loader = loader
+        self._audit = audit
+
+    def __getattr__(self, name):
+        return getattr(self._loader, name)
+
+    def __len__(self):
+        return len(self._loader)
+
+    def __iter__(self):
+        try:
+            for batch in self._loader:
+                if "__autosim_source_id__" not in batch:
+                    raise RuntimeError("exposure audit source marker was lost during collation")
+                self._audit.observe(batch.pop("__autosim_source_id__"))
+                yield batch
+        finally:
+            self._audit.close_iterator()
+
