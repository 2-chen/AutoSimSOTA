+    if aliases:
+        print("[ACT train] Applying legacy dataset feature aliases:")
+        for alias_key, source_key in aliases.items():
+            print(f"  {source_key} -> {alias_key}")
+    return _AliasedLeRobotDataset(
+        dataset,
