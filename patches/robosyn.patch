+class _BenchmarkAlignedImageTransform:
+    """Apply one mild, 10-frame-consistent perturbation to every camera view."""
+
+    def __init__(self, profile):
+        self.profile = str(profile)
+
+    def apply_item(self, item, image_keys, idx):
+        from torchvision.transforms import InterpolationMode
+        from torchvision.transforms import functional as tvf
+
+        keys = sorted(key for key in image_keys if key in item)
+        if not keys:
+            return
+        generator = torch.Generator(device="cpu")
+        # LeRobot workers have independent initial seeds. Grouping by ten frames
+        # mirrors the benchmark's interval randomizers without making every
+        # adjacent observation an unrelated color/geometry domain.
+        block = int(idx) // 10
+        generator.manual_seed((int(torch.initial_seed()) + 1_000_003 * block) % (2**63 - 1))
+
+        def uniform(low, high):
+            value = torch.rand((), generator=generator).item()
+            return float(low + (high - low) * value)
+
+        if self.profile == "camera_geometry_mild":
+            scale = uniform(0.96, 1.04)
+            shift_x = uniform(-0.025, 0.025)
+            shift_y = uniform(-0.025, 0.025)
+            for key in keys:
+                image = item[key]
+                height, width = image.shape[-2:]
+                item[key] = tvf.affine(
+                    image,
+                    angle=0.0,
+                    translate=[int(round(width * shift_x)), int(round(height * shift_y))],
+                    scale=scale,
+                    shear=[0.0, 0.0],
+                    interpolation=InterpolationMode.BILINEAR,
+                    fill=0,
+                )
+            return
+
+        if self.profile == "illumination_step_mild":
+            brightness = uniform(0.90, 1.10)
+            contrast = uniform(0.90, 1.10)
+            saturation = uniform(0.92, 1.08)
+            for key in keys:
+                image = tvf.adjust_brightness(item[key], brightness)
+                image = tvf.adjust_contrast(image, contrast)
+                item[key] = tvf.adjust_saturation(image, saturation)
+            return
+
+        raise ValueError(f"unknown benchmark-aligned transform: {self.profile}")
+
+
+def _masked_action_l1_loss(actions, predictions, action_is_pad, profile):
+    elementwise = F.l1_loss(actions, predictions, reduction="none")
+    valid = (~action_is_pad).unsqueeze(-1).expand_as(elementwise)
+    if profile == "legacy_mask_mean":
+        return (elementwise * valid).mean()
+    if profile == "valid_mean":
+        return (elementwise * valid).sum() / valid.sum().clamp_min(1)
+    raise ValueError(f"unknown action loss profile: {profile}")
+
+
+def _patch_act_loss_profile(profile):
+    """Patch only ACT's scalar loss reduction; model inputs/outputs stay unchanged."""
+
+    if profile == "legacy_mask_mean":
+        return
+    from lerobot.constants import ACTION, OBS_IMAGES
+    from lerobot.policies.act.modeling_act import ACTPolicy
+
+    def forward(policy, batch):
+        batch = policy.normalize_inputs(batch)
+        if policy.config.image_features:
+            batch = dict(batch)
+            batch[OBS_IMAGES] = [batch[key] for key in policy.config.image_features]
+        batch = policy.normalize_targets(batch)
+        actions_hat, (mu_hat, log_sigma_x2_hat) = policy.model(batch)
+        l1_loss = _masked_action_l1_loss(
+            batch[ACTION], actions_hat, batch["action_is_pad"], profile
+        )
+        loss_dict = {"l1_loss": l1_loss.item()}
+        if policy.config.use_vae:
+            mean_kld = (
+                -0.5
+                * (1 + log_sigma_x2_hat - mu_hat.pow(2) - log_sigma_x2_hat.exp())
+            ).sum(-1).mean()
+            loss_dict["kld_loss"] = mean_kld.item()
+            loss = l1_loss + mean_kld * policy.config.kl_weight
+        else:
+            loss = l1_loss
+        return loss, loss_dict
+
+    ACTPolicy.forward = forward
+
+
+def _as_template_type(value, template):
+    array = np.asarray(value)
+    if isinstance(template, torch.Tensor):
+        return torch.as_tensor(array, dtype=template.dtype, device=template.device)
+    if isinstance(template, np.ndarray):
+        return array.astype(template.dtype, copy=False)
+    return array
+
+
+def _merge_feature_statistics(metas):
+    """Merge per-dataset population moments using their recorded frame counts.
+
+    LeRobot stores mean/std/count for every normalized feature.  A concatenated
+    dataset must combine the first two moments; copying the first dataset's
+    metadata silently normalizes all supplemental data with official-only stats.
+    """
+
+    if not metas:
+        raise ValueError("at least one dataset metadata object is required")
+    common_features = set(metas[0].stats)
+    for meta in metas[1:]:
+        common_features &= set(meta.stats)
+
+    merged = {}
+    for feature in sorted(common_features):
+        parts = [meta.stats[feature] for meta in metas]
+        required = {"mean", "std", "count"}
+        if not all(required <= set(part) for part in parts):
+            merged[feature] = copy.deepcopy(parts[0])
+            continue
+
+        counts = np.asarray(
+            [float(np.asarray(part["count"]).reshape(-1)[0]) for part in parts],
+            dtype=np.float64,
+        )
+        if np.any(counts <= 0) or not np.isfinite(counts).all():
+            raise ValueError(f"invalid statistics counts for {feature}: {counts}")
+        means = [np.asarray(part["mean"], dtype=np.float64) for part in parts]
+        stds = [np.asarray(part["std"], dtype=np.float64) for part in parts]
+        total = float(counts.sum())
+        mean = sum(count * value for count, value in zip(counts, means)) / total
+        second_moment = sum(
+            count * (std**2 + part_mean**2)
+            for count, std, part_mean in zip(counts, stds, means)
+        ) / total
+        std = np.sqrt(np.maximum(second_moment - mean**2, 0.0))
+
+        result = copy.deepcopy(parts[0])
+        result["mean"] = _as_template_type(mean, parts[0]["mean"])
+        result["std"] = _as_template_type(std, parts[0]["std"])
+        result["count"] = _as_template_type(
+            np.asarray([total]), parts[0]["count"]
+        )
+        if all("min" in part for part in parts):
+            minimum = np.minimum.reduce(
+                [np.asarray(part["min"], dtype=np.float64) for part in parts]
+            )
+            result["min"] = _as_template_type(minimum, parts[0]["min"])
+        if all("max" in part for part in parts):
+            maximum = np.maximum.reduce(
+                [np.asarray(part["max"], dtype=np.float64) for part in parts]
+            )
+            result["max"] = _as_template_type(maximum, parts[0]["max"])
+        merged[feature] = result
+    return merged
+
+
+def _episode_progress(dataset):
+    boundaries = dataset.episode_data_index
+    starts = np.asarray(boundaries["from"], dtype=np.int64)
+    stops = np.asarray(boundaries["to"], dtype=np.int64)
+    progress = np.empty(len(dataset), dtype=np.float64)
+    for start, stop in zip(starts, stops):
+        length = int(stop - start)
+        if length <= 0:
+            raise ValueError(f"invalid episode boundary [{start}, {stop})")
+        progress[start:stop] = np.linspace(0.0, 1.0, length, dtype=np.float64)
+    return progress
+
+
+def _build_stratified_sample_weights(datasets, entries, sampling):
+    """Return per-frame weights with explicit profile mass and phase emphasis."""
+
+    if len(datasets) != len(entries):
+        raise ValueError("dataset entries and loaded datasets differ in length")
+    profile_masses = dict(sampling.get("profile_masses", {}))
+    phase_bins = sampling.get(
+        "phase_bins",
+        [
+            {"name": "early", "start": 0.0, "end": 0.45, "weight": 0.75},
+            {"name": "approach", "start": 0.45, "end": 0.75, "weight": 1.0},
+            {"name": "contact_recovery", "start": 0.75, "end": 1.01, "weight": 2.0},
+        ],
+    )
+    if profile_masses:
+        entry_profiles = [str(entry.get("profile", "unknown")) for entry in entries]
+        missing = sorted(set(entry_profiles) - set(profile_masses))
+        if missing:
+            raise ValueError(f"profile_masses missing profiles: {missing}")
+        present_profile_mass = {
+            profile: float(profile_masses[profile]) for profile in set(entry_profiles)
+        }
+        profile_total = sum(present_profile_mass.values())
+        frames_by_profile = {
+            profile: sum(
+                len(dataset)
+                for dataset, candidate in zip(datasets, entry_profiles)
+                if candidate == profile
+            )
+            for profile in set(entry_profiles)
+        }
+        # profile_masses are aggregate masses. If a role has multiple lineage
+        # shards (e.g. early + late corrections), divide its mass by frames.
+        mass_values = np.asarray(
+            [
+                present_profile_mass[profile]
+                / profile_total
+                * len(dataset)
+                / frames_by_profile[profile]
+                for dataset, profile in zip(datasets, entry_profiles)
+            ],
+            dtype=np.float64,
+        )
+    else:
+        mass_values = np.asarray([len(dataset) for dataset in datasets], dtype=np.float64)
+    if np.any(mass_values <= 0):
+        raise ValueError("all dataset/profile masses must be positive")
+    mass_values /= mass_values.sum()
+
+    all_weights = []
+    audit_parts = []
+    for dataset, entry, target_mass in zip(datasets, entries, mass_values):
+        progress = _episode_progress(dataset)
+        phase_weights = np.zeros(len(dataset), dtype=np.float64)
+        realized_phase_counts = {}
+        for phase in phase_bins:
+            name = str(phase["name"])
+            start = float(phase["start"])
+            end = float(phase["end"])
+            weight = float(phase["weight"])
+            mask = (progress >= start) & (progress < end)
+            phase_weights[mask] = weight
+            realized_phase_counts[name] = int(mask.sum())
+        if np.any(phase_weights <= 0):
+            raise ValueError("phase_bins do not cover every episode progress value")
+        horizon_config = dict(sampling.get("horizon_weighting") or {})
+        horizon_mode = str(horizon_config.get("mode", "none"))
+        horizon_weights = np.ones(len(dataset), dtype=np.float64)
+        if horizon_mode != "none":
+            if horizon_mode != "linear_floor":
+                raise ValueError(f"unknown horizon weighting mode: {horizon_mode}")
+            chunk_size = int(horizon_config.get("chunk_size", 50))
+            floor = float(horizon_config.get("floor", 0.25))
+            if chunk_size <= 0 or not 0.0 < floor <= 1.0:
+                raise ValueError("horizon weighting requires chunk_size>0 and 0<floor<=1")
+            boundaries = dataset.episode_data_index
+            for start, stop in zip(boundaries["from"], boundaries["to"]):
+                start, stop = int(start), int(stop)
+                remaining = np.arange(stop - start, 0, -1, dtype=np.float64)
+                horizon_weights[start:stop] = np.maximum(
+                    np.minimum(remaining, chunk_size) / chunk_size,
+                    floor,
+                )
+        phase_weights *= horizon_weights
+        local_weights = phase_weights / phase_weights.sum() * target_mass
+        all_weights.append(local_weights)
+        audit_parts.append(
+            {
+                "profile": str(entry.get("profile", "unknown")),
+                "root": str(entry.get("root", "")),
+                "frames": len(dataset),
+                "target_sampling_mass": float(target_mass),
+                "phase_frame_counts": realized_phase_counts,
+                "horizon_weighting": horizon_config or {"mode": "none"},
+                "mean_horizon_weight": float(horizon_weights.mean()),
+            }
+        )
+    weights = np.concatenate(all_weights)
+    weights /= weights.sum()
+    return torch.as_tensor(weights, dtype=torch.double), audit_parts
+
+
