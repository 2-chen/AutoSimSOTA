+def _collect_policy_corrections(args, env, gym_config, seed_stream) -> bool:
+    """Collect expert suffixes from states visited by a frozen parent policy."""
+
+    target_episodes = int(gym_config.get("max_episodes", 1))
+    max_attempts = int(args.collection_max_attempts or target_episodes * 12)
+    policy_adapter, model = _load_correction_policy(args)
+    prefix_rng = np.random.RandomState(int(args.collection_seed) ^ 0x5A17C0DE)
+    saved_episodes = _get_saved_episode_count(env)
+    _reset_env(env, seed_stream, reason="policy_correction_start")
+    saved_episodes = _get_saved_episode_count(env)
+
+    progress = tqdm.tqdm(
+        total=target_episodes,
+        initial=min(saved_episodes, target_episodes),
+        desc="Saved policy-induced expert corrections",
+        unit="episode",
+    )
+    while saved_episodes < target_episodes:
+        if len(seed_stream.attempts) >= max_attempts:
+            raise RuntimeError(
+                f"Correction collection exceeded {max_attempts} attempts."
+            )
+        episode_seed = seed_stream.current_seed
+        prefix_target = int(
+            prefix_rng.randint(
+                args.correction_prefix_min, args.correction_prefix_max + 1
+            )
+        )
+        policy_adapter.reset_model(model)
+        obs = env.unwrapped.get_obs()
+        reset_policy_state = _extract_policy_state(obs)
+        prefix_steps = 0
+        policy_success = False
+        prefix_truncated = False
+        while prefix_steps < prefix_target:
+            obs, info, truncated, _ = policy_adapter.eval(env, model, obs)
+            prefix_steps = int(info["elapsed_steps"].item())
+            policy_success = bool(env.get_wrapper_attr("is_task_success")())
+            prefix_truncated = bool(
+                truncated.any().item()
+                if isinstance(truncated, torch.Tensor)
+                else np.asarray(truncated).any()
+            )
+            if policy_success or prefix_truncated:
+                break
+
+        if policy_success or prefix_truncated:
+            reason = (
+                "parent_policy_already_succeeded"
+                if policy_success
+                else "parent_policy_prefix_truncated"
+            )
+            _reset_env(
+                env,
+                seed_stream,
+                options={"save_data": False},
+                reason=f"retry_after_{reason}",
+            )
+            seed_stream.record_attempt(
+                episode_seed,
+                saved=False,
+                reason=reason,
+                policy_prefix_steps=prefix_steps,
+                requested_prefix_steps=prefix_target,
+            )
+            continue
+
+        _clear_policy_prefix_from_recorder(env)
+        valid = generate_and_execute_action_list(
+            env, 0, getattr(args, "debug_mode", False), regenerate=False
+        )
+        used_safe_return = False
+        if not valid and args.correction_safe_return_steps > 0:
+            used_safe_return = True
+            _execute_safe_return(
+                env, reset_policy_state, args.correction_safe_return_steps
+            )
+            valid = generate_and_execute_action_list(
+                env, 0, getattr(args, "debug_mode", False), regenerate=True
+            )
+        before = _get_saved_episode_count(env)
+        _reset_env(
+            env,
+            seed_stream,
+            options={"save_data": bool(valid and env.get_wrapper_attr("is_task_success")())},
+            reason="save_policy_induced_expert_correction",
+        )
+        saved_episodes = _get_saved_episode_count(env)
+        saved = bool(saved_episodes > before)
+        seed_stream.record_attempt(
+            episode_seed,
+            saved=saved,
+            reason=(
+                "saved_policy_induced_expert_correction"
+                if saved
+                else "expert_correction_failed"
+            ),
+            policy_prefix_steps=prefix_steps,
+            requested_prefix_steps=prefix_target,
+            expert_plan_valid=bool(valid),
+            safe_return_used=used_safe_return,
+            safe_return_steps=(
+                args.correction_safe_return_steps if used_safe_return else 0
+            ),
+        )
+        progress.update(max(0, min(saved_episodes, target_episodes) - progress.n))
+    progress.close()
+    return True
+
